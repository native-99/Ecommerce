# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# Jangan pernah meng-commit .env.

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=

# Minimal 32 byte. Buat dengan: openssl rand -hex 32
APP_JWT_SECRET=

XENDIT_API_KEY=
XENDIT_PUBLIC_KEY=
# Verification token from Xendit dashboard (Settings > Webhooks)
XENDIT_CALLBACK_TOKEN=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_PAYMENT_SUCCESS_TEMPLATE_ID=
SENDGRID_PAYMENT_ERROR_TEMPLATE_ID=

# Optional (defaults are fine for local development)
# PORT=3000
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SPRING_PROFILES_ACTIVE=prod
